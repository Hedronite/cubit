# The toolchain every published artifact is built with. go.mod's `go 1.26` is the
# floor the source supports; this is the exact release the archives are built
# with, and the one a rebuild must use. release.sh refuses any other Go.
# Keep it equal to the go-version in .github/workflows/release.yml and ci.yml
# (the contract tests check) and to docs/versions.md.
GO_VERSION=1.27.4
